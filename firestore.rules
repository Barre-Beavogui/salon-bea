rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'barre.beavogui@icloud.com',
        'eliebarresbeavogui3@gmail.com'
      ];
    }

    function validAppointmentCreate() {
      return request.resource.data.keys().hasOnly([
        'name',
        'phone',
        'email',
        'service',
        'preferredDate',
        'message',
        'status',
        'source',
        'createdAt'
      ]) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() > 1 &&
      request.resource.data.phone is string &&
      request.resource.data.phone.size() > 5 &&
      request.resource.data['service'] is string &&
      request.resource.data['service'].size() > 1 &&
      request.resource.data.status == 'Nouveau';
    }

    match /galleryItems/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /articles/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /trainings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /appointments/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if validAppointmentCreate();
    }
  }
}
